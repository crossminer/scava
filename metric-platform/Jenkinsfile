pipeline {
  agent any
  stages {
    stage('Build Metric Platform') {
      steps {
        dir(path: 'metric-platform/') {
          sh 'mvn clean install -DskipTests'
        }
      }
    }
    stage('Test Metric Platform') {
      steps {
        dir(path: 'metric-platform/') {
          sh 'mvn test integration-test'
        }
      }
      post {
        success {
          archiveArtifacts 'metric-platform/releng/org.eclipse.scava.product/target/products/*.zip'
        }
      }
    }
    stage('Publish artefacts') {
      steps {
        zip zipFile: 'metric-platform-linux-gtk-x86_64.zip', archive: true, dir: 'metric-platform/releng/org.eclipse.scava.product/target/products/scava-product/linux/gtk/x86_64/'
        }
      }
    }
  }
  post {
    always {
	  junit '**/target/surefire-reports/TEST-*.xml'
	}
  }
}

